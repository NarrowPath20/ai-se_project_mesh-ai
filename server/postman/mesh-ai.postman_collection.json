{
  "info": {
    "name": "MeshAI Part 2",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Project-owned Part 2 collection. Set pdf_path to a text PDF; provide a Nebius API key in the server environment for the RAG folder."
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000"
    },
    {
      "key": "email",
      "value": ""
    },
    {
      "key": "password",
      "value": "MeshAI-test-12345"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "chat_id",
      "value": ""
    },
    {
      "key": "pdf_path",
      "value": "tests/fixtures/launch.pdf"
    }
  ],
  "item": [
    {
      "name": "Core",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response envelope', () => { const b = pm.response.json(); pm.expect(b).to.have.all.keys('success', 'data', 'error'); pm.expect(b.success).to.eql(true); pm.expect(b.error).to.eql(null); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Reject unauthenticated chats",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/chats"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 401', () => pm.response.to.have.status(401));",
                  "pm.test('Response envelope', () => { const b = pm.response.json(); pm.expect(b).to.have.all.keys('success', 'data', 'error'); pm.expect(b.success).to.eql(false); pm.expect(b.error.message).to.be.a('string'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Reject unauthenticated documents",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/documents"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 401', () => pm.response.to.have.status(401));",
                  "pm.test('Response envelope', () => { const b = pm.response.json(); pm.expect(b).to.have.all.keys('success', 'data', 'error'); pm.expect(b.success).to.eql(false); pm.expect(b.error.message).to.be.a('string'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Reject unauthenticated query",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/query",
            "body": {
              "mode": "raw",
              "raw": "{\"question\":\"Test\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 401', () => pm.response.to.have.status(401));",
                  "pm.test('Response envelope', () => { const b = pm.response.json(); pm.expect(b).to.have.all.keys('success', 'data', 'error'); pm.expect(b.success).to.eql(false); pm.expect(b.error.message).to.be.a('string'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"{{email}}\",\"password\":\"{{password}}\",\"name\":\"Postman Test\"}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('email', 'meshai-' + pm.variables.replaceIn('{{$guid}}') + '@example.com');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.test('Response envelope', () => { const b = pm.response.json(); pm.expect(b).to.have.all.keys('success', 'data', 'error'); pm.expect(b.success).to.eql(true); pm.expect(b.error).to.eql(null); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"{{email}}\",\"password\":\"{{password}}\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response envelope', () => { const b = pm.response.json(); pm.expect(b).to.have.all.keys('success', 'data', 'error'); pm.expect(b.success).to.eql(true); pm.expect(b.error).to.eql(null); });",
                  "pm.collectionVariables.set('token', pm.response.json().data.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create chat",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{base_url}}/chats",
            "body": {
              "mode": "raw",
              "raw": "{\"title\":\"PDF research\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.test('Response envelope', () => { const b = pm.response.json(); pm.expect(b).to.have.all.keys('success', 'data', 'error'); pm.expect(b.success).to.eql(true); pm.expect(b.error).to.eql(null); });",
                  "pm.collectionVariables.set('chat_id', pm.response.json().data._id);"
                ]
              }
            }
          ]
        },
        {
          "name": "List chats",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{base_url}}/chats"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response envelope', () => { const b = pm.response.json(); pm.expect(b).to.have.all.keys('success', 'data', 'error'); pm.expect(b.success).to.eql(true); pm.expect(b.error).to.eql(null); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Chat history",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{base_url}}/chats/{{chat_id}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response envelope', () => { const b = pm.response.json(); pm.expect(b).to.have.all.keys('success', 'data', 'error'); pm.expect(b.success).to.eql(true); pm.expect(b.error).to.eql(null); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Missing question",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{base_url}}/query",
            "body": {
              "mode": "raw",
              "raw": "{}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 400', () => pm.response.to.have.status(400));",
                  "pm.test('Response envelope', () => { const b = pm.response.json(); pm.expect(b).to.have.all.keys('success', 'data', 'error'); pm.expect(b.success).to.eql(false); pm.expect(b.error.message).to.be.a('string'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "List documents",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{base_url}}/documents"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response envelope', () => { const b = pm.response.json(); pm.expect(b).to.have.all.keys('success', 'data', 'error'); pm.expect(b.success).to.eql(true); pm.expect(b.error).to.eql(null); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "RAG (requires Nebius)",
      "item": [
        {
          "name": "Upload PDF",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{base_url}}/documents",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "title",
                  "type": "text",
                  "value": "Launch notes"
                },
                {
                  "key": "file",
                  "type": "file",
                  "src": "{{pdf_path}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.test('Response envelope', () => { const b = pm.response.json(); pm.expect(b).to.have.all.keys('success', 'data', 'error'); pm.expect(b.success).to.eql(true); pm.expect(b.error).to.eql(null); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Query documents",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{base_url}}/query",
            "body": {
              "mode": "raw",
              "raw": "{\"question\":\"What is the launch code?\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response envelope', () => { const b = pm.response.json(); pm.expect(b).to.have.all.keys('success', 'data', 'error'); pm.expect(b.success).to.eql(true); pm.expect(b.error).to.eql(null); });",
                  "pm.test('Generated answer', () => pm.expect(pm.response.json().data.answer).to.be.a('string').and.not.empty);"
                ]
              }
            }
          ]
        },
        {
          "name": "Send chat message",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{base_url}}/chats/{{chat_id}}/messages",
            "body": {
              "mode": "raw",
              "raw": "{\"question\":\"What is the launch code?\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.test('Response envelope', () => { const b = pm.response.json(); pm.expect(b).to.have.all.keys('success', 'data', 'error'); pm.expect(b.success).to.eql(true); pm.expect(b.error).to.eql(null); });",
                  "pm.test('Both messages', () => pm.expect(pm.response.json().data.map(m => m.role)).to.eql(['user','assistant']));"
                ]
              }
            }
          ]
        },
        {
          "name": "Persisted chat history",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{base_url}}/chats/{{chat_id}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response envelope', () => { const b = pm.response.json(); pm.expect(b).to.have.all.keys('success', 'data', 'error'); pm.expect(b.success).to.eql(true); pm.expect(b.error).to.eql(null); });",
                  "pm.test('History saved', () => pm.expect(pm.response.json().data.messages.length).to.be.at.least(2));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
